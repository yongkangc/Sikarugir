+#import <Cocoa/Cocoa.h>
+#import <unistd.h>
+#import "NSTask+Extension.h"
+#import "NSAlert+Extension.h"
+#import "NSFileManager+Extension.h"
+
+// Keep the process helper's error paths observable without opening application UI.
+@implementation NSAlert (PerformanceProbe)
++(void)showAlertOfType:(NSAlertType)type withMessage:(NSString*)message
+{
+    fprintf(stderr, "%s\n", message.UTF8String);
+}
+@end
+
+@implementation NSFileManager (PerformanceProbe)
+-(BOOL)directoryExistsAtPath:(NSString*)path
+{
+    BOOL isDirectory = NO;
+    return [self fileExistsAtPath:path isDirectory:&isDirectory] && isDirectory;
+}
+@end
+
+static void report(NSDictionary* result)
+{
+    NSData* json = [NSJSONSerialization dataWithJSONObject:result options:0 error:nil];
+    fwrite(json.bytes, 1, json.length, stdout);
+    putchar('\n');
+}
+
+int main(int argc, const char* argv[])
+{
+    @autoreleasepool {
+        if (argc < 2) return 2;
+        NSString* mode = @(argv[1]);
+        if ([mode isEqualToString:@"child-large"]) {
+            char chunk[16384];
+            memset(chunk, 'A', sizeof(chunk));
+            for (int i = 0; i < 64; i++) {
+                size_t written = 0;
+                while (written < sizeof(chunk)) {
+                    ssize_t count = write(STDOUT_FILENO, chunk + written, sizeof(chunk) - written);
+                    if (count <= 0) return 3;
+                    written += count;
+                }
+            }
+            return 0;
+        }
+        if ([mode isEqualToString:@"child-sleep"]) {
+            usleep(1000000);
+            return 0;
+        }
+        if ([mode isEqualToString:@"child-stdin"]) {
+            char buffer[16];
+            while (read(STDIN_FILENO, buffer, sizeof(buffer)) > 0) {}
+            puts("EOF");
+            return 0;
+        }
+        NSString* executable = [@(argv[0]) stringByStandardizingPath];
+        NSString* childMode = [@{@"large":@"child-large", @"nowait":@"child-sleep",
+                                @"stdin":@"child-stdin", @"nowait-large":@"child-large"} objectForKey:mode];
+        BOOL wait = ![mode hasPrefix:@"nowait"];
+        NSTimeInterval start = NSProcessInfo.processInfo.systemUptime;
+        NSString* output;
+        if ([mode isEqualToString:@"small"]) {
+            output = [NSTask runProgram:@"/usr/bin/printf" atRunPath:nil
+                             withFlags:@[@"hello world\n"] wait:YES];
+        } else if ([mode isEqualToString:@"cwd"]) {
+            output = [NSTask runProgram:@"/bin/pwd" atRunPath:@"/private/tmp"
+                             withFlags:@[] wait:YES];
+        } else if (childMode) {
+            output = [NSTask runProgram:executable atRunPath:nil
+                             withFlags:@[childMode] wait:wait];
+        } else {
+            return 2;
+        }
+        NSTimeInterval elapsed = NSProcessInfo.processInfo.systemUptime - start;
+        report(@{@"mode":mode, @"seconds":@(elapsed), @"length":@(output.length),
+                 @"valid":@([mode isEqualToString:@"large"] ?
+                            (output.length == 1048576 &&
+                             [output rangeOfCharacterFromSet:[[NSCharacterSet characterSetWithCharactersInString:@"A"] invertedSet]].location == NSNotFound) :
+                            [mode isEqualToString:@"small"] ? [output isEqualToString:@"hello world\n"] :
+                            [mode isEqualToString:@"stdin"] ? [output isEqualToString:@"EOF\n"] :
+                            [mode isEqualToString:@"cwd"] ? [output isEqualToString:@"/private/tmp\n"] :
+                            output.length == 0)});
+    }
+    return 0;
+}
